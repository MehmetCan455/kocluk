# Kocluk API — front controller, directory protection, no directory listing.
#
# Deployed as public_html/api/.htaccess. Every request under /api is answered
# by index.php; source, tooling and dependency directories are never served.
# AllowOverride must permit Options, rewrite and auth directives (cPanel's
# default "All" does).

Options -Indexes
DirectoryIndex index.php

# Everything except the front controller is denied below. These blocks are the
# fallback that also holds when mod_rewrite is unavailable.
<IfModule mod_authz_core.c>
    <FilesMatch "^(?!index\.php$).+\.php$">
        Require all denied
    </FilesMatch>

    <FilesMatch "\.(?:sql|md|json|log|env|ini|bak|sh|dist|lock)$">
        Require all denied
    </FilesMatch>

    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(?!index\.php$).+\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    <FilesMatch "\.(?:sql|md|json|log|env|ini|bak|sh|dist|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Source, CLI, migration, test, vendor and VCS directories: 403. The
    # leading "/*" tolerates "//src/..." paths: per-directory rewrite input
    # keeps one leading slash when the request has a double slash.
    RewriteRule ^/*(?:src|bin|migrations|tests|vendor|\.git)(?:/|$) - [F,NC,L]

    # Configuration and tooling files.
    RewriteRule ^/*(?:config\.php|config\.example\.php|composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?)$ - [F,NC,L]

    # Data, log and documentation artefacts anywhere in the tree. The API error
    # log may sit next to an in-tree config, so .log must be denied too.
    RewriteRule \.(?:sql|md|json|log|env|ini|bak|sh)$ - [F,NC,L]

    # Dotfiles (.env, .gitignore, ...); ACME challenges stay reachable.
    RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,NC,L]

    # Unknown paths become the front controller; the router answers 404/405.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
